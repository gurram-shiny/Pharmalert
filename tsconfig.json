{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "backend/**/*.ts",
    "datasets/**/*.ts",
    "tests/unit/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "extends": "expo/tsconfig.base"
}
